//// [tests/cases/conformance/jsdoc/jsdocVariadicType.ts] ////

=== a.js ===
/**
 * @type {function(boolean, string, ...*):void}
 */
const foo = function (a, b, ...r) { };
>foo : (: boolean, : string, : any[]) => void
>function (a, b, ...r) { } : (a: boolean, b: string, : any[]) => void
>a : boolean
>b : string
>r : [: any[]]

=== b.ts ===
foo(false, '');
>foo(false, '') : void
>foo : (: boolean, : string, : any[]) => void
>false : false
>'' : ""

